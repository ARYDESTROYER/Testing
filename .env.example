# Local development uses a SQLite file at ./data/chi.db by default — no configuration needed.
#
# To run against Turso (or any libsql server) in production, set both of these.
# The same code path serves both; only the URL scheme changes.
# TWIN_DATABASE_URL=libsql://your-database.turso.io
# TWIN_DATABASE_AUTH_TOKEN=your-token
#
# Password for the researcher dashboard at /data. If unset, the dashboard is open.
# TWIN_DASHBOARD_PASSWORD=
